{
    "compilerOptions": {
        "baseUrl": ".",
        "ignoreDeprecations": "6.0",
        "inlineSourceMap": true,
        "inlineSources": true,
        "module": "ESNext",
        "target": "es6",
        "noImplicitAny": true,
        "skipLibCheck": true,
        "moduleResolution": "node",
        "lib": ["dom", "es5", "scripthost", "es2015"]
    },
    "include": ["src/**/*.ts"]
}
